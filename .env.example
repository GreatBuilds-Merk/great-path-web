# Copy this file to .env.local for local dev.
# Set the SAME values in Vercel -> Settings -> Environment Variables.
# Never commit .env.local — .gitignore already excludes it.

# --- Site URL (used in emails + links). No trailing slash. ---
# Must match BRAND.domain in lib/brand.js. If you ever move to greatpath.ai,
# change it in BOTH places.
SITE_URL=https://www.greatpathadvisors.com

# --- Supabase: SERVER (service key bypasses RLS — server routes ONLY, never a client component) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Supabase: BROWSER (anon key + RLS — safe to expose) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Great Path Advisors <success@greatpathadvisors.com>

# --- Engine worker on Railway (not needed until the mini-report lands) ---
GP_ENGINE_URL=http://localhost:8000
